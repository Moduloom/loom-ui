{
  "name": "loom-ui",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Shared React UI used by Loom, with independent components and design tokens",
  "files": [
    "dist/components",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "loom-source": "./src/index.ts",
      "import": "./dist/components/index.js"
    },
    "./styles.css": {
      "loom-source": "./src/styles.css",
      "default": "./dist/components/styles.css"
    }
  },
  "scripts": {
    "build": "vite build --config component-build.config.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.0.0"
  },
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.18"
  }
}
